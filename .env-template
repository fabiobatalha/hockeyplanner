# Use the URL recipients can open from their devices.
HOCKEYPLANNER_PUBLIC_URL=https://hockeyplanner.ca

# Fill in the values provided by your SMTP provider.
HOCKEYPLANNER_SMTP_HOST=
HOCKEYPLANNER_SMTP_FROM=
HOCKEYPLANNER_SMTP_USERNAME=
HOCKEYPLANNER_SMTP_PASSWORD=

# Use ssl with port 465 for implicit TLS.
HOCKEYPLANNER_SMTP_SECURITY=starttls
HOCKEYPLANNER_SMTP_PORT=587

# Optional Google Analytics 4 web-stream Measurement ID. Leave blank to disable.
HOCKEYPLANNER_GA_MEASUREMENT_ID=
# Optional Google Tag Manager container. Takes precedence over the direct GA4 tag.
HOCKEYPLANNER_GTM_CONTAINER_ID=
